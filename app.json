{
  "expo": {
    "name": "TripPot",
    "slug": "trippot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trippotsteam.trippot"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.trippotsteam.trippot"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7971a07a-f0f0-4ac8-a575-2dea8a16ff8b"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "영수증·프로필·커뮤니티 사진을 올리기 위해 사진 접근이 필요해요.",
          "cameraPermission": "영수증을 촬영하기 위해 카메라 접근이 필요해요.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "trippot",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7971a07a-f0f0-4ac8-a575-2dea8a16ff8b"
    }
  }
}
